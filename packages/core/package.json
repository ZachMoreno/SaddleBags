{
  "name": "@saddlebags/core",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/store-contract.d.ts",
      "import": "./dist/testing/store-contract.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@saddlebags/sdk": "workspace:*",
    "zod": "^4.1.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
